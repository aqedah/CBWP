rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function codes() { return get(/databases/$(database)/documents/secrets/codes).data; }
    function hasUnlock(key) { return exists(/databases/$(database)/documents/unlocks/$(request.auth.uid + '_' + key)); }

    // 쓰기: 팀 비밀번호(인도자 · 서기 · 리더) 또는 관리자 · 좋은만남의축제는 어느 팀이든 팀 비밀번호
    function canTeam(team) { return signedIn() && (hasUnlock(team) || hasUnlock('admin') || (team == 'festival' && hasUnlock('any'))); }
    // 보기: 위 + 팀원 비밀번호(팀이름_member) · 좋은만남의축제는 어느 팀이든 팀원 비밀번호
    function canRead(team) { return canTeam(team) || (signedIn() && (hasUnlock(team + '_member') || (team == 'festival' && hasUnlock('anyread')))); }
    function canLead(team) { return signedIn() && (hasUnlock(team + '_lead') || hasUnlock('admin')); }
    // 교회 공용(곡 · 악보): 보기는 팀원도, 고치기는 팀 비밀번호
    function canSharedRead() { return signedIn() && (hasUnlock('any') || hasUnlock('anyread') || hasUnlock('admin')); }
    function canSharedWrite() { return signedIn() && (hasUnlock('any') || hasUnlock('admin')); }
    // 팀원도 쓸 수 있는 events: 참여 응답(avail_) · 프로필 사진(ph_) · 한마디 · 기도제목 · 나눔
    function memberEvent(id, d) { return id.matches('avail_.*') || id.matches('ph_.*') || (d.post is string && d.post in ['talk', 'prayer', 'share', 'avail', 'photo']); }

    match /secrets/{doc} { allow read, write: if false; }

    match /unlocks/{key} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && key == request.auth.uid + '_' + request.resource.data.team
        && (
          (request.resource.data.team == 'any' && request.resource.data.src is string
             && !request.resource.data.src.matches('.*_member') && request.resource.data.code == codes()[request.resource.data.src])
          || (request.resource.data.team == 'anyread' && request.resource.data.src is string
             && request.resource.data.code == codes()[request.resource.data.src])
          || (!(request.resource.data.team in ['any', 'anyread']) && request.resource.data.code == codes()[request.resource.data.team])
        );
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if canSharedRead();
      allow write: if signedIn() && (request.auth.uid == uid || hasUnlock('admin'));
    }

    // 콘티: 보기는 팀원도, 쓰기는 팀 비밀번호
    match /contis/{id} {
      allow read: if canRead(resource.data.team);
      allow create, update: if canTeam(request.resource.data.team);
      allow delete: if canTeam(resource.data.team);
    }
    // 멤버 명단: 보기는 팀원도, 고치기는 리더 비밀번호(또는 관리자)
    match /members/{id} {
      allow read: if canRead(resource.data.team);
      allow create, update: if canLead(request.resource.data.team);
      allow delete: if canLead(resource.data.team);
    }
    // 일정 · 편성 · 출결 · 게시글: 팀 비밀번호 / 팀원은 참여 응답 · 사진 · 한마디 · 기도제목 · 나눔만
    match /events/{id} {
      allow read: if canRead(resource.data.team);
      allow create, update: if canTeam(request.resource.data.team)
        || (canRead(request.resource.data.team) && memberEvent(id, request.resource.data));
      allow delete: if canTeam(resource.data.team)
        || (canRead(resource.data.team) && memberEvent(id, resource.data) && resource.data.by == request.auth.uid);
    }
    // 팀 설정(공지 · 템플릿 · 편성 …): 보기는 팀원도, 고치기는 팀 비밀번호
    match /teams/{team} {
      allow read: if canRead(team);
      allow write: if canTeam(team);
    }

    match /bylaws/{team} { allow read: if canRead(team); allow write: if signedIn() && hasUnlock('admin'); }
    match /bylawsChunks/{id} { allow read: if canRead(resource.data.team); allow write: if signedIn() && hasUnlock('admin'); }

    // 교회 공용 자료: 곡 · 제목 목록은 팀 비밀번호로 고치기, 그림(악보 · 프로필 사진)은 팀원도 올리기
    match /songs/{id} { allow read: if canSharedRead(); allow write: if canSharedWrite(); }
    match /catalog/{id} { allow read: if canSharedRead(); allow write: if canSharedWrite(); }
    // 그림: 주소(긴 번호)를 아는 사람은 한 장씩 볼 수 있어요 (공유 콘티의 악보) · 목록 보기와 올리기는 팀원만
    match /imgs/{id} { allow get: if true; allow list, write: if canSharedRead(); }
    match /imgChunks/{id} { allow get: if true; allow list, write: if canSharedRead(); }
    match /tplFiles/{id} { allow read, write: if canSharedRead(); }
    match /tplChunks/{id} { allow read, write: if canSharedRead(); }
    // 공유 콘티(보기 전용 사본): 공지 주소를 받은 누구나 보기 · 만들고 고치기는 그 팀 비밀번호
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canTeam(request.resource.data.team);
      allow delete: if canTeam(resource.data.team);
    }
  }
}
